# Upstream source and build output are reproducible; don't track them.
/emacs-src/
/build/
/install/
*.log

# Inside the init directory, track only the hand-written config.
/config/*
!/config/init.el
!/config/early-init.el
!/config/fastfind.el
!/config/startpage.el
!/config/docsbuffer.el
!/config/gitfolders.el
!/config/llm.el
!/config/llm-council.el
!/config/shortcuts.el
!/config/dictate.el
!/config/emacs-session.el
!/config/calendar-year.el

# Python bytecode from the test runner
__pycache__/
*.pyc
/dist/

# Claude Code's own local session state, not project content
/.claude/
!/config/mode-reference.el
!/config/disk-usage.el
!/config/synonyms.el
!/config/typing-game.el
!/config/ai-tools.el

# Scratch local tooling (e.g. puppeteer-core, for real GUI/browser screenshots
# during development) --- not a tracked project dependency, no package.json here.
/node_modules/

# tools/node-lsp/package.json (tracked) lists the web/UI language servers this
# project uses; the packages themselves are not tracked, same as config/elpa.
/tools/node-lsp/node_modules/

# A real, pinned local Node.js runtime (downloaded from nodejs.org, checksum
# verified before extracting) --- this branch's own system Node was too old for
# the latest @angular/cli (needs >=22.22.3; this machine had 22.22.0), and
# downloading one locally (same self-contained shape as tools/jdk on the
# lsp-java branch) avoided needing root to upgrade the real system Node, which
# other things on this machine may depend on staying as it is.
/tools/node/

# tools/node-lsp/angular-fixture/package.json (tracked) is a real, minimal
# Angular workspace for tests/ert/languages-web-lsp.el's --lsp-gated ngserver
# test only --- the packages themselves are not tracked, same as config/elpa.
/tools/node-lsp/angular-fixture/node_modules/

# A real, local Python venv for the `aider' CLI (a separate tool from the Emacs
# package `aidermacs', which drives it) --- same self-contained shape as
# tools/node-lsp/ and tools/node/ above.
/tools/aider/.venv/
