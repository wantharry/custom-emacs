;; -*- lexical-binding: t; -*-
;; Realistic workflows used to check a pruned Emacs. Each prints OK/ERROR and
;; writes the list of Lisp files it loaded to $S/trace-NAME.txt.
;; Usage (see tools/verify-prune.sh):
;;   S=outdir R=repo-root emacs -Q --batch -l tools/workflows.el --eval '(run-workflow "name")'
;; Needs network for the package-* and url-https workflows.
(setq native-comp-jit-compilation nil byte-compile-warnings nil)
(defvar S (or (getenv "S") temporary-file-directory))
(defvar tmp (make-temp-file "wf" t))
(defun wf-package-refresh ()
  (require 'package)
  (setq package-user-dir (concat tmp "/pkgs") package-check-signature nil
        package-archives '(("nongnu" . "https://elpa.nongnu.org/nongnu/") ("gnu" . "https://elpa.gnu.org/packages/") ("melpa" . "https://melpa.org/packages/")))
  (package-refresh-contents)
  (unless (assq 'evil package-archive-contents) (error "no evil in archive")))
(defun wf-package-install ()
  (wf-package-refresh) (package-install 'evil)
  (unless (package-installed-p 'evil) (error "evil not installed")))
(defun wf-package-install-signed ()
  (require 'package)
  (setq package-user-dir (concat tmp "/pkgs2")
        package-archives '(("gnu" . "https://elpa.gnu.org/packages/")))
  (package-refresh-contents) (package-install 'rainbow-mode))
(defun wf-url-https ()
  (require 'url)
  (with-current-buffer (url-retrieve-synchronously "https://elpa.gnu.org/packages/archive-contents" t nil 30)
    (unless (> (buffer-size) 1000) (error "small response"))))
(defun wf-vc ()
  (require 'vc) (require 'vc-git)
  (let ((default-directory (concat (getenv "R") "/"))) (vc-git-root default-directory) (vc-state (concat (getenv "R") "/README.md")) (vc-git-working-revision (concat (getenv "R") "/README.md"))))
(defun wf-diff-ediff ()
  (require 'diff-mode) (require 'ediff) (require 'smerge-mode)
  (let ((a (concat tmp "/a")) (b (concat tmp "/b"))) (with-temp-file a (insert "x\n")) (with-temp-file b (insert "y\n"))
    (with-current-buffer (diff-no-select a b nil t) (diff-mode) (font-lock-ensure))))
(defun wf-dired-grep-find ()
  (require 'dired) (require 'dired-aux) (require 'grep) (require 'find-dired) (require 'find-cmd)
  (dired tmp) (find-cmd '(name "*.el"))
  (grep-compute-defaults))
