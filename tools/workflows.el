  (require 'shortdoc) (shortdoc-display-group 'string) (require 'info) (Info-find-file "emacs"))
(defun wf-customize ()
  (require 'cus-edit) (require 'wid-edit) (custom-buffer-create (list (list 'fill-column 'custom-variable))))
(defun wf-calendar ()
  (require 'calendar) (require 'diary-lib) (require 'holidays) (require 'icalendar)
  (calendar-holiday-list) (require 'time-date))
(defun wf-tramp ()
